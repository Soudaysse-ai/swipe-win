# ── Base de données ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:pass@localhost:5432/defiyas
DB_POOL_MAX=10

# ── Sécurité ────────────────────────────────────────────────────────────────
# 32 caractères minimum en production (le serveur refuse de démarrer sinon)
JWT_SECRET=change-me-with-a-long-random-string-of-32-chars-min
JWT_EXPIRES_IN=12h            # durée du jeton administrateur
PLAYER_SESSION_DAYS=30        # durée d'une session joueur (révocable)
# Origines autorisées (frontend), séparées par des virgules. Obligatoire en production.
# « * » remplace un segment de domaine : https://defi-yas-*.vercel.app (aperçus Vercel).
CORS_ORIGINS=https://www.defi-yas.com,https://defi-yas.com

# ── Numéros acceptés ────────────────────────────────────────────────────────
# Par défaut : +269 suivi de 7 chiffres commençant par 4 (règle du site actuel)
# PHONE_REGEX=^\+269[34]\d{6}$

# ── E-mails (réinitialisation du mot de passe) via Resend ──────────────────
# Sans clé : en développement les e-mails sont écrits dans les logs ;
# en production l'envoi échoue (le joueur doit passer par le service client).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
MAIL_FROM=Défi Yas <no-reply@defi-yas.com>   # domaine à vérifier dans Resend
MAIL_REPLY_TO=
APP_URL=https://www.defi-yas.com             # base des liens envoyés par e-mail
RESET_TOKEN_MINUTES=30
EMAIL_REQUIRED=false                         # true = e-mail obligatoire à l'inscription

# ── Premier administrateur (créé par `npm run seed` s'il n'existe pas) ─────
ADMIN_EMAIL=admin@yas.km
ADMIN_PASSWORD=

# ── Divers ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production
APP_TIMEZONE=Indian/Comoro
# BLOCKED_WORDS=mot1,mot2     # mots interdits supplémentaires (chat, pseudonymes)
