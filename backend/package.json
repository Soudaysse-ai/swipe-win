{
  "name": "defi-yas-backend",
  "version": "2.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "db:backup": "node scripts/backup.js",
    "test": "node --test 'test/unit/*.test.js'",
    "test:integration": "node --test --test-concurrency=1 'test/integration/*.test.js'",
    "test:all": "npm test && npm run test:integration",
    "sync:foot": "node scripts/sync-foot-physics.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "socket.io": "^4.8.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "socket.io-client": "^4.8.1"
  },
  "engines": {
    "node": ">=20"
  }
}
